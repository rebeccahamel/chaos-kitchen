---
// One page per recipe (SPEC.md §6.2). The page is rendered at the base yield; the script
// at the bottom rescales the ingredient list and the step placeholders in the browser (§5.3).
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import RecipePhoto from '../../components/RecipePhoto.astro';
import placeholder from '../../assets/placeholder-recipe.svg';
import { describeIngredient } from '../../lib/format.ts';
import { loadLists } from '../../lib/lists.ts';
import { recipePhoto } from '../../lib/photos.ts';
import { renderStepParts } from '../../lib/placeholders.ts';
import { flattenIngredients, formatDuration, hasGroups, ingredientsById, totalTime } from '../../lib/recipe.ts';
import { url } from '../../lib/site.ts';
import { tagLabel } from '../../lib/tags.ts';
import { findUnit, unitLabel } from '../../lib/units.ts';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { data } = recipe;
const lists = loadLists();
const { units } = lists;
const person = lists.people.find((p) => p.id === data.author);

const yieldUnit = findUnit(units, data.yield.unit);
const yieldLabel = yieldUnit ? unitLabel(yieldUnit, data.yield.amount) : data.yield.unit;

const times = [
  ['Gesamt', totalTime(data.time)],
  ['Zubereitung', data.time.prep],
  ['Kochen/Backen', data.time.cook],
  ['Ruhezeit', data.time.rest],
].filter((entry): entry is [string, number] => entry[1] !== undefined);

const byId = ingredientsById(data.ingredients);
let stepNumber = 0;
const stepGroups = data.steps.map((group) => ({
  group: group.group,
  items: group.items.map((step) => ({ number: ++stepNumber, parts: renderStepParts(step, byId, units) })),
}));

const photo = recipePhoto(recipe.id);
const preview = photo ? await getImage({ src: photo, width: 1200, height: 900, format: 'jpg' }) : placeholder;
const ogImage = new URL(preview.src, Astro.site).href;
const added = data.added.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

// Data for the yield control in the browser
const clientData = JSON.stringify({
  baseYield: data.yield.amount,
  yieldUnit: yieldUnit ?? null,
  units,
  ingredients: flattenIngredients(data.ingredients),
}).replace(/</g, '\\u003c');
---

<Base title={data.title} description={data.description} ogImage={ogImage}>
  <article class="recipe" id="recipe">
    <a class="back" id="back" href={url()}>‹ Alle Rezepte</a>

    <div class="hero">
      <RecipePhoto slug={recipe.id} alt={data.title} priority sizes="(min-width: 760px) 720px, 100vw" />
    </div>

    <header class="head">
      <h1>{data.title}</h1>
      <p class="description">{data.description}</p>
      <p class="meta">
        {person && <Avatar person={person} size="sm" />}
        <span>{person?.name} · hinzugefügt am {added}</span>
      </p>
      {
        data.tags.length > 0 && (
          <ul class="chips">
            {data.tags.map((tag) => (
              <li>
                <a class="tag" href={url(`?tag=${tag}`)}>{tagLabel(lists.tags, tag)}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <dl class="times">
      {
        times.map(([label, minutes]) => (
          <div>
            <dt>{label}</dt>
            <dd>{formatDuration(minutes)}</dd>
          </div>
        ))
      }
    </dl>

    <section class="ingredients">
      <h2>Zutaten</h2>

      <div class="yield" id="yield">
        <div class="yield-control">
          <button type="button" class="yield-button" id="yield-minus" aria-label="Menge um 1 verringern">−</button>
          <input class="yield-input" id="yield-input" type="number" inputmode="numeric" min="1" step="1" value={data.yield.amount} aria-label="Menge" />
          <button type="button" class="yield-button" id="yield-plus" aria-label="Menge um 1 erhöhen">+</button>
          <span class="yield-unit" id="yield-unit">{yieldLabel}</span>
        </div>
        <button type="button" class="linklike" id="yield-reset" hidden>Zurücksetzen</button>
        {data.yield.note && <span class="note">{data.yield.note}</span>}
      </div>

      {
        data.ingredients.map((group) => (
          <div class="group">
            {hasGroups(data.ingredients) && group.group && <h3>{group.group}</h3>}
            <ul class="ingredient-list">
              {group.items.map((ingredient) => {
                const text = describeIngredient(ingredient, units);
                return (
                  <li class="ingredient" data-id={ingredient.id}>
                    <span class="amount">{[text.amount, text.unit].filter(Boolean).join(' ')}</span>
                    <span class="name">
                      <span class="name-text">{text.name}</span>
                      {ingredient.note && <span class="note">, {ingredient.note}</span>}
                      {text.optional && <span class="note"> (optional)</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="steps">
      <h2>Zubereitung</h2>
      {
        stepGroups.map((group) => (
          <div class="group">
            {hasGroups(data.steps) && group.group && <h3>{group.group}</h3>}
            <ol class="step-list">
              {group.items.map((step) => (
                <li class="step" data-step={step.number}>
                  <span class="step-number" aria-hidden="true">{step.number}</span>
                  <p>
                    <span class="visually-hidden">Schritt {step.number}: </span>
                    {step.parts.map((part) =>
                      part.kind === 'ingredient' ? (
                        <mark class="mention" data-id={part.id} data-mode={part.placeholder.mode} data-fraction={part.placeholder.fraction}>
                          {part.text}
                        </mark>
                      ) : (
                        part.text
                      ),
                    )}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <div class="cook-bar">
      <button type="button" class="cook-toggle" id="cook-toggle" aria-pressed="false">Kochmodus starten</button>
      <p class="cook-note" id="cook-note" hidden></p>
    </div>
  </article>

  <script type="application/json" id="recipe-data" set:html={clientData} />
</Base>

<style>
  .recipe {
    display: grid;
    gap: 28px;
    max-width: 720px;
    margin-inline: auto;
  }

  .back {
    font-size: 15px;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .hero {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .head {
    display: grid;
    gap: 12px;
  }

  h1 {
    font-size: clamp(30px, 6vw, 42px);
    color: var(--kuerbis);
  }

  .description {
    font-size: 19px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--kastanie);
  }

  .times {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding-block: 12px;
    border-top: 1px solid var(--karamell);
    border-bottom: 1px solid var(--karamell);
    font-size: 15px;
  }

  .times div {
    display: flex;
    gap: 6px;
  }

  .times dt {
    color: var(--kastanie);
  }

  .times dd {
    margin: 0;
    font-weight: 700;
  }

  .yield {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .yield-control {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px 5px 5px;
    background: var(--papier);
    border: 1px solid var(--karamell);
    border-radius: 999px;
  }

  .yield-button {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: var(--rost);
    color: var(--papier);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .yield-button:hover {
    background: var(--kuerbis);
  }

  .yield-input {
    width: 3.2em;
    padding: 0;
    border: none;
    background: transparent;
    text-align: center;
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--kuerbis);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .yield-input::-webkit-outer-spin-button,
  .yield-input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .yield-unit {
    font-size: 18px;
    padding-left: 4px;
  }

  .ingredients,
  .steps {
    display: grid;
    gap: 16px;
  }

  h2 {
    font-size: 26px;
    color: var(--kuerbis);
  }

  h3 {
    font-size: 19px;
    margin-bottom: 8px;
  }

  .ingredient-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 16px;
    list-style: none;
    background: var(--papier);
    border: 1px solid var(--karamell);
    border-radius: var(--radius);
  }

  .ingredient {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .amount {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .step-list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 10px;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1;
    color: var(--kuerbis);
    padding-top: 2px;
  }

  .mention {
    background: var(--senf-hell);
    color: inherit;
    border-bottom: 2px solid var(--senf);
    border-radius: 3px;
    padding-inline: 2px;
  }

  /* Kochmodus (SPEC.md §6.3): floating toggle, tap to tick off */
  .cook-bar {
    position: sticky;
    bottom: 0;
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-inline: calc(-1 * var(--gutter));
    padding: 12px var(--gutter) 14px;
    background: linear-gradient(to top, var(--leinen) 70%, transparent);
  }

  .cook-toggle {
    padding: 10px 20px;
    border: none;
    border-radius: 999px;
    background: var(--rost);
    color: var(--papier);
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(46, 31, 23, 0.18);
    cursor: pointer;
  }

  .cook-toggle[aria-pressed='true'] {
    background: var(--olive);
  }

  .cook-note {
    font-size: 14px;
    color: var(--kastanie);
    text-align: center;
  }

  .recipe.cooking .ingredient,
  .recipe.cooking .step {
    cursor: pointer;
    border-radius: 6px;
  }

  .recipe.cooking .ingredient:hover,
  .recipe.cooking .step:hover {
    background: rgba(217, 164, 65, 0.12);
  }

  .recipe.cooking .done {
    color: var(--kastanie);
  }

  .recipe.cooking .ingredient.done .amount,
  .recipe.cooking .ingredient.done .name-text {
    text-decoration: line-through;
  }

  .recipe.cooking .step.done .step-number,
  .recipe.cooking .step.done .mention {
    color: var(--kastanie);
    background: transparent;
    border-color: transparent;
  }
</style>

<script>
  // Back link: return to the overview with the search and filters that were active (SPEC.md §6.2).
  const back = document.getElementById('back') as HTMLAnchorElement;
  const referrer = document.referrer;
  if (referrer) {
    try {
      const from = new URL(referrer);
      if (from.origin === location.origin && from.pathname === new URL(back.href).pathname) back.href = referrer;
    } catch {
      // not a URL: keep the plain link
    }
  }
</script>

<script>
  // Yield control (SPEC.md §5.3): rescales the ingredient list and every step placeholder.
  import { describeIngredient } from '../../lib/format.ts';
  import { renderPlaceholder, type Placeholder } from '../../lib/placeholders.ts';
  import { unitLabel } from '../../lib/units.ts';
  import type { Ingredient, UnitDef } from '../../lib/types.ts';

  interface RecipeData {
    baseYield: number;
    yieldUnit: UnitDef | null;
    units: UnitDef[];
    ingredients: Ingredient[];
  }

  const data = JSON.parse(document.getElementById('recipe-data')?.textContent ?? '{}') as RecipeData;
  const ingredients = new Map(data.ingredients.map((ingredient) => [ingredient.id, ingredient]));

  const article = document.getElementById('recipe') as HTMLElement;
  const input = document.getElementById('yield-input') as HTMLInputElement;
  const minus = document.getElementById('yield-minus') as HTMLButtonElement;
  const plus = document.getElementById('yield-plus') as HTMLButtonElement;
  const unitEl = document.getElementById('yield-unit') as HTMLElement;
  const reset = document.getElementById('yield-reset') as HTMLButtonElement;
  const rows = Array.from(article.querySelectorAll<HTMLElement>('.ingredient[data-id]'));
  const mentions = Array.from(article.querySelectorAll<HTMLElement>('.mention[data-id]'));

  // The chosen yield is kept for the browser session, like the Kochmodus ticks.
  const storageKey = `yield:${location.pathname}`;

  function loadYield(): number {
    try {
      const saved = Number(sessionStorage.getItem(storageKey));
      return Number.isInteger(saved) && saved >= 1 ? saved : data.baseYield;
    } catch {
      return data.baseYield;
    }
  }

  function saveYield(value: number) {
    try {
      if (value === data.baseYield) sessionStorage.removeItem(storageKey);
      else sessionStorage.setItem(storageKey, String(value));
    } catch {
      // storage unavailable: the yield still works for this page view
    }
  }

  let current = loadYield();

  function render() {
    const factor = current / data.baseYield;

    for (const row of rows) {
      const ingredient = ingredients.get(row.dataset.id ?? '');
      if (!ingredient) continue;
      const text = describeIngredient(ingredient, data.units, { factor });
      const amount = row.querySelector('.amount');
      const name = row.querySelector('.name-text');
      if (amount) amount.textContent = [text.amount, text.unit].filter(Boolean).join(' ');
      if (name) name.textContent = text.name;
    }

    for (const mention of mentions) {
      const ingredient = ingredients.get(mention.dataset.id ?? '');
      if (!ingredient) continue;
      const placeholder: Placeholder = {
        id: ingredient.id,
        mode: mention.dataset.mode === 'name' ? 'name' : 'full',
        fraction: mention.dataset.fraction ? Number(mention.dataset.fraction) : undefined,
      };
      mention.textContent = renderPlaceholder(placeholder, ingredient, data.units, factor);
    }

    input.value = String(current);
    if (data.yieldUnit) unitEl.textContent = unitLabel(data.yieldUnit, current);
    reset.hidden = current === data.baseYield;
    minus.disabled = current <= 1;
  }

  function setYield(value: number, reason: 'change' | 'reset') {
    const next = Math.max(1, Math.round(value));
    if (!Number.isFinite(next) || next === current) return;
    current = next;
    render();
    saveYield(current);
    // Kochmodus listens to this to clear ticked items when the yield is reset (SPEC.md §6.3).
    article.dispatchEvent(new CustomEvent('recipe:yield', { detail: { yield: current, reason } }));
  }

  minus.addEventListener('click', () => setYield(current - 1, 'change'));
  plus.addEventListener('click', () => setYield(current + 1, 'change'));
  reset.addEventListener('click', () => setYield(data.baseYield, 'reset'));

  input.addEventListener('input', () => {
    const value = Number(input.value);
    if (input.value !== '' && Number.isFinite(value) && value >= 1) setYield(value, 'change');
  });
  input.addEventListener('blur', () => render()); // empty or invalid input falls back to the last valid yield
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') input.blur();
  });

  render();
</script>

<script>
  // Kochmodus (SPEC.md §6.3): keep the screen awake, tick off ingredients and steps by tapping.
  // Ticked state is kept for the browser session and cleared when the mode is turned off
  // or the yield is reset.
  const article = document.getElementById('recipe') as HTMLElement;
  const toggle = document.getElementById('cook-toggle') as HTMLButtonElement;
  const note = document.getElementById('cook-note') as HTMLElement;
  const items = Array.from(article.querySelectorAll<HTMLElement>('.ingredient[data-id], .step[data-step]'));
  const storageKey = `kochmodus:${location.pathname}`;

  interface Saved {
    on: boolean;
    done: string[];
  }

  let on = false;
  let wakeLock: WakeLockSentinel | null = null;

  const keyOf = (item: HTMLElement) => (item.dataset.id ? `i:${item.dataset.id}` : `s:${item.dataset.step}`);

  function save() {
    try {
      if (!on) sessionStorage.removeItem(storageKey);
      else {
        const done = items.filter((item) => item.classList.contains('done')).map(keyOf);
        sessionStorage.setItem(storageKey, JSON.stringify({ on, done } satisfies Saved));
      }
    } catch {
      // storage unavailable (private mode): the mode still works for this page view
    }
  }

  function load(): Saved | null {
    try {
      const raw = sessionStorage.getItem(storageKey);
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  }

  function showNote(text: string) {
    note.textContent = text;
    note.hidden = text === '';
  }

  async function requestWakeLock() {
    if (!('wakeLock' in navigator)) {
      showNote('Antippen zum Abhaken. Dein Browser kann den Bildschirm nicht wach halten, er geht vielleicht aus.');
      return;
    }
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => {
        wakeLock = null;
      });
      showNote('Antippen zum Abhaken. Der Bildschirm bleibt an.');
    } catch {
      showNote('Antippen zum Abhaken. Der Bildschirm konnte nicht wach gehalten werden, er geht vielleicht aus.');
    }
  }

  function releaseWakeLock() {
    wakeLock?.release();
    wakeLock = null;
  }

  function clearDone() {
    for (const item of items) {
      item.classList.remove('done');
      item.setAttribute('aria-pressed', 'false');
    }
  }

  function setMode(next: boolean) {
    on = next;
    article.classList.toggle('cooking', on);
    toggle.setAttribute('aria-pressed', String(on));
    toggle.textContent = on ? 'Kochmodus beenden' : 'Kochmodus starten';
    for (const item of items) {
      if (on) {
        item.setAttribute('role', 'button');
        item.setAttribute('tabindex', '0');
        item.setAttribute('aria-pressed', item.classList.contains('done') ? 'true' : 'false');
      } else {
        item.removeAttribute('role');
        item.removeAttribute('tabindex');
        item.removeAttribute('aria-pressed');
      }
    }
    if (on) {
      void requestWakeLock();
    } else {
      releaseWakeLock();
      clearDone();
      showNote('');
    }
    save();
  }

  function toggleItem(item: HTMLElement) {
    if (!on) return;
    const done = item.classList.toggle('done');
    item.setAttribute('aria-pressed', String(done));
    save();
  }

  for (const item of items) {
    item.addEventListener('click', () => toggleItem(item));
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleItem(item);
      }
    });
  }

  toggle.addEventListener('click', () => setMode(!on));

  // A yield reset clears the ticks; the mode itself stays on.
  article.addEventListener('recipe:yield', (event) => {
    if ((event as CustomEvent<{ reason: string }>).detail.reason === 'reset' && on) {
      clearDone();
      save();
    }
  });

  // The wake lock is released when the tab goes to the background; take it again on return.
  document.addEventListener('visibilitychange', () => {
    if (on && document.visibilityState === 'visible' && wakeLock === null) void requestWakeLock();
  });

  // Restore the session state after a reload while cooking.
  const saved = load();
  if (saved?.on) {
    const done = new Set(saved.done);
    for (const item of items) if (done.has(keyOf(item))) item.classList.add('done');
    setMode(true);
  }
</script>
