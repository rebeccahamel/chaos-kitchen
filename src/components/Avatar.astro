---
// Round author avatar: the illustration when one exists, otherwise the initial on the
// person's colour (SPEC.md §6.5).
import { Image } from 'astro:assets';
import { avatarImage } from '../lib/photos.ts';
import type { Person } from '../lib/types.ts';

interface Props {
  person: Person;
  size?: 'sm' | 'md';
}

const { person, size = 'md' } = Astro.props;
const image = avatarImage(person.avatar);
const pixels = size === 'sm' ? 24 : 40;
---

{
  image ? (
    <Image class:list={['avatar', size]} src={image} width={pixels * 2} height={pixels * 2} alt={person.name} />
  ) : (
    <span class:list={['avatar', 'initial', size]} style={`background: ${person.color}`} role="img" aria-label={person.name}>
      {person.name.charAt(0)}
    </span>
  )
}

<style>
  .avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar.sm {
    width: 24px;
    height: 24px;
  }

  .initial {
    display: inline-grid;
    place-items: center;
    color: var(--papier);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
  }

  .initial.sm {
    font-size: 12px;
  }
</style>
