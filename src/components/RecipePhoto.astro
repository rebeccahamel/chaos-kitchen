---
// Recipe photo in a 4:3 frame, cropped centrally, in responsive sizes;
// the striped placeholder when there is no photo yet (SPEC.md §6.5).
import { Image } from 'astro:assets';
import placeholder from '../assets/placeholder-recipe.svg';
import { recipePhoto } from '../lib/photos.ts';

interface Props {
  slug: string;
  alt: string;
  /** true for the large photo at the top of a recipe page */
  priority?: boolean;
  /** how wide the photo is displayed, so the browser picks a fitting size */
  sizes?: string;
}

const { slug, alt, priority = false, sizes = '100vw' } = Astro.props;
const photo = recipePhoto(slug);
---

<div class="photo">
  {
    photo ? (
      <Image src={photo} alt={alt} width={1200} height={900} layout="constrained" priority={priority} sizes={sizes} />
    ) : (
      <img src={placeholder.src} alt="" width="800" height="600" loading="lazy" />
    )
  }
</div>

<style>
  .photo {
    aspect-ratio: 4 / 3;
    max-width: 100%;
    overflow: hidden;
    background: var(--papier);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
