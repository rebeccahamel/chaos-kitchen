---
// "Diese Woche" and "Nächste Woche" on the homepage (MEAL_PLANNER.md §14, SPEC.md §6.9): one
// slide per planned week with its days as mini cards, a tick box per recipe for the shopping
// list, a Bring! button for the ticked recipes, and the merged list itself. Two weeks sit side by
// side in a strip that swipes on phones; arrows switch between them. Every slide is rendered with
// all recipes ticked; the script at the bottom keeps ticks, list and Bring! link in step per
// week, opens the strip on the week that contains today, and labels the slides accordingly.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import placeholder from '../assets/placeholder-recipe.svg';
import { describeIngredient } from '../lib/format.ts';
import { recipePhoto } from '../lib/photos.ts';
import { isoDate, weekKey, weekRecipes, weekTitle, weekdayName, type Plan, type PlanEntry, type Week } from '../lib/plan.ts';
import { flattenIngredients, formatDuration, totalTime } from '../lib/recipe.ts';
import { consolidateIngredients, selectionMask } from '../lib/shopping.ts';
import { recipeUrl, url } from '../lib/site.ts';
import type { Lists } from '../lib/types.ts';

interface Props {
  plan: Plan;
  /** all recipes, trial ones included */
  recipes: CollectionEntry<'recipes'>[];
  lists: Lists;
}

const { plan, recipes, lists } = Astro.props;
const { units } = lists;
const bySlug = new Map(recipes.map((recipe) => [recipe.id, recipe]));

const slots: [keyof Pick<Week['days'][number], 'lunch' | 'dinner'>, string][] = [
  ['lunch', 'Mittag'],
  ['dinner', 'Abend'],
];

// Bring! (SPEC.md §6.8) fetches the hidden week page of the ticked recipes and reads its JSON-LD
const bringBase = 'https://api.getbring.com/rest/bringrecipes/deeplink?source=web&url=';

/** Everything one slide needs, computed once per week. */
const slides = plan.weeks.map((week, index) => {
  const key = weekKey(week);
  /** the recipes of the week in plan order; their position is the tick box index and the mask digit */
  const planned = weekRecipes(week).map((slug) => bySlug.get(slug)!);
  const indexOf = new Map(planned.map((recipe, i) => [recipe.id, i]));
  const listUrlBase = new URL(url(`woche/${key}/liste/`), Astro.site).href;
  const allMask = selectionMask(planned.map(() => true));
  const items = consolidateIngredients(
    planned.map((recipe) => flattenIngredients(recipe.data.ingredients)),
    units,
  ).map((ingredient) => describeIngredient(ingredient, units));

  /** the recipe a leftovers entry points at, via the day it was cooked */
  const leftoversOf = (entry: { leftovers: Date }): CollectionEntry<'recipes'> | undefined => {
    const day = week.days.find((d) => isoDate(d.date) === isoDate(entry.leftovers));
    const source = [day?.dinner, day?.lunch].find((e): e is { recipe: string } => e !== undefined && 'recipe' in e);
    return source ? bySlug.get(source.recipe) : undefined;
  };

  // Data for the script: ingredients per recipe, units, and where the week's hidden pages live
  const clientData = JSON.stringify({
    weekKey: key,
    units,
    recipes: planned.map((recipe) => ({ slug: recipe.id, ingredients: flattenIngredients(recipe.data.ingredients) })),
    listUrlBase,
    bringBase,
  }).replace(/</g, '\\u003c');

  return {
    week,
    key,
    // the script corrects these by date; without it the first week is this week
    label: index === 0 ? 'Diese Woche' : 'Nächste Woche',
    planned,
    indexOf,
    items,
    bringHref: bringBase + encodeURIComponent(`${listUrlBase}${allMask}/`),
    leftoversOf,
    clientData,
  };
});
---

<section class:list={['week', { multi: slides.length > 1 }]} id="week" aria-label="Wochenplan">
  <button type="button" class="arrow prev" data-prev aria-label="Vorherige Woche" hidden>‹</button>
  <button type="button" class="arrow next" data-next aria-label="Nächste Woche" hidden>›</button>

  <div class="track" data-track>
    {
      slides.map((slide) => (
        <article class="slide" data-week={slide.key}>
          <header class="week-head">
            <h2 data-week-label>{slide.label}</h2>
            <p class="week-dates">{weekTitle(slide.week)}</p>
            {slide.week.note && <p class="week-note">{slide.week.note}</p>}
          </header>

          <ol class="days">
            {slide.week.days.map((day) => (
              <li class="day">
                <h3 class="weekday">{weekdayName(day.date)}</h3>
                {!day.lunch && !day.dinner && <p class="free">frei</p>}
                {slots.map(([slot, label]) => {
                  const entry: PlanEntry | undefined = day[slot];
                  if (!entry) return null;
                  if ('recipe' in entry) {
                    const recipe = bySlug.get(entry.recipe)!;
                    const index = slide.indexOf.get(recipe.id)!;
                    const photo = recipePhoto(recipe.id);
                    return (
                      <div class:list={['slot', slot]}>
                        <span class="label">{label}</span>
                        <article class="meal">
                          <a class="meal-link" href={recipeUrl(recipe.id)}>
                            {photo ? (
                              <Image class="thumb" src={photo} alt="" width={160} height={120} sizes="80px" />
                            ) : (
                              <img class="thumb" src={placeholder.src} alt="" width="160" height="120" loading="lazy" />
                            )}
                            <span class="meal-text">
                              <span class="meal-title">{recipe.data.title}</span>
                              <span class="meal-meta">{formatDuration(totalTime(recipe.data.time))}</span>
                            </span>
                          </a>
                          <input
                            class="pick"
                            type="checkbox"
                            data-pick={index}
                            checked
                            aria-label={`${recipe.data.title} auf die Einkaufsliste`}
                          />
                        </article>
                      </div>
                    );
                  }
                  if ('leftovers' in entry) {
                    const source = slide.leftoversOf(entry);
                    return (
                      <div class:list={['slot', slot]}>
                        <span class="label">{label}</span>
                        <p class="plain">
                          Reste{source && <>: <a href={recipeUrl(source.id)}>{source.data.title}</a></>}
                        </p>
                      </div>
                    );
                  }
                  return (
                    <div class:list={['slot', slot]}>
                      <span class="label">{label}</span>
                      <p class="plain">{entry.text}</p>
                    </div>
                  );
                })}
              </li>
            ))}
          </ol>

          <div class="shopping">
            <p class="pick-status">
              <span data-pick-count>{slide.planned.length === 1 ? '1 Rezept' : `${slide.planned.length} Rezepte`} auf der Einkaufsliste</span>
              <button type="button" class="linklike" data-pick-all hidden>Alle</button>
              <button type="button" class="linklike" data-pick-none>Keine</button>
            </p>
            <p class="bring">
              <a class="bring-link" data-bring href={slide.bringHref} rel="noopener noreferrer">Zutaten der Woche an Bring! senden</a>
              <span class="note">öffnet die Einkaufslisten-App Bring!</span>
            </p>
            <details class="list">
              <summary>Einkaufsliste anzeigen</summary>
              <ul class="ingredient-list" data-list>
                {slide.items.map((item) => (
                  <li class="ingredient">
                    <span class="amount">{[item.amount, item.unit].filter(Boolean).join(' ')}</span>
                    <span class="name">
                      {item.name}
                      {item.optional && <span class="note"> (optional)</span>}
                    </span>
                  </li>
                ))}
              </ul>
              <p class="note empty" data-list-empty hidden>Kein Rezept ausgewählt.</p>
            </details>
          </div>

          <script type="application/json" data-plan set:html={slide.clientData} />
        </article>
      ))
    }
  </div>
</section>

<script>
  // Per week: ticks, "Alle" / "Keine", the Bring! link and the merged list follow each other in
  // the browser. The ticks are kept per week in the visitor's own browser (localStorage), so a
  // family member's choice survives until the plan changes and never affects anyone else.
  // For the strip: open on the week that contains today, label the slides, drive the arrows.
  import { describeIngredient } from '../lib/format.ts';
  import { consolidateIngredients, selectionMask } from '../lib/shopping.ts';
  import type { Ingredient, UnitDef } from '../lib/types.ts';

  interface PlanData {
    weekKey: string;
    units: UnitDef[];
    recipes: { slug: string; ingredients: Ingredient[] }[];
    listUrlBase: string;
    bringBase: string;
  }

  function setUpWeek(slide: HTMLElement) {
    const dataEl = slide.querySelector('[data-plan]');
    if (!dataEl) return;
    const data = JSON.parse(dataEl.textContent ?? '{}') as PlanData;
    const boxes = Array.from(slide.querySelectorAll<HTMLInputElement>('input[data-pick]')).sort(
      (a, b) => Number(a.dataset.pick) - Number(b.dataset.pick),
    );
    const count = slide.querySelector('[data-pick-count]') as HTMLElement;
    const all = slide.querySelector('[data-pick-all]') as HTMLButtonElement;
    const none = slide.querySelector('[data-pick-none]') as HTMLButtonElement;
    const bring = slide.querySelector('[data-bring]') as HTMLAnchorElement;
    const list = slide.querySelector('[data-list]') as HTMLElement;
    const empty = slide.querySelector('[data-list-empty]') as HTMLElement;
    const storageKey = `plan:${data.weekKey}`;

    function load(): boolean[] | null {
      try {
        const raw = localStorage.getItem(storageKey);
        const saved = raw ? (JSON.parse(raw) as unknown) : null;
        return Array.isArray(saved) && saved.length === boxes.length ? saved.map(Boolean) : null;
      } catch {
        return null;
      }
    }

    function save(selected: boolean[]) {
      try {
        if (selected.every(Boolean)) localStorage.removeItem(storageKey);
        else localStorage.setItem(storageKey, JSON.stringify(selected));
      } catch {
        // storage unavailable: the ticks still work for this page view
      }
    }

    function renderList(selected: boolean[]) {
      const lists = data.recipes.filter((_, index) => selected[index]).map((recipe) => recipe.ingredients);
      const items = consolidateIngredients(lists, data.units).map((ingredient) => describeIngredient(ingredient, data.units));
      list.replaceChildren(
        ...items.map((item) => {
          const li = document.createElement('li');
          li.className = 'ingredient';
          const amount = document.createElement('span');
          amount.className = 'amount';
          amount.textContent = [item.amount, item.unit].filter(Boolean).join(' ');
          const name = document.createElement('span');
          name.className = 'name';
          name.textContent = item.name;
          if (item.optional) {
            const note = document.createElement('span');
            note.className = 'note';
            note.textContent = ' (optional)';
            name.append(note);
          }
          li.append(amount, name);
          return li;
        }),
      );
      list.hidden = items.length === 0;
      empty.hidden = items.length > 0;
    }

    function render() {
      const selected = boxes.map((box) => box.checked);
      const chosen = selected.filter(Boolean).length;
      count.textContent = `${chosen === 1 ? '1 Rezept' : `${chosen} Rezepte`} auf der Einkaufsliste`;
      all.hidden = chosen === boxes.length;
      none.hidden = chosen === 0;
      if (chosen === 0) {
        bring.setAttribute('aria-disabled', 'true');
        bring.removeAttribute('href');
      } else {
        bring.removeAttribute('aria-disabled');
        bring.href = data.bringBase + encodeURIComponent(`${data.listUrlBase}${selectionMask(selected)}/`);
      }
      renderList(selected);
      save(selected);
    }

    for (const box of boxes) box.addEventListener('change', render);
    all.addEventListener('click', () => {
      for (const box of boxes) box.checked = true;
      render();
    });
    none.addEventListener('click', () => {
      for (const box of boxes) box.checked = false;
      render();
    });

    const saved = load();
    if (saved) boxes.forEach((box, index) => (box.checked = saved[index]));
    render();
  }

  const section = document.getElementById('week');
  const track = section?.querySelector<HTMLElement>('[data-track]');
  if (section && track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-week]'));
    for (const slide of slides) setUpWeek(slide);

    // This week is the last one that has started by today (local date, like the family's calendar);
    // the labels follow. Until the first week starts, it is "this week" anyway.
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    let current = 0;
    slides.forEach((slide, index) => {
      if ((slide.dataset.week ?? '') <= today) current = index;
    });
    slides.forEach((slide, index) => {
      const label = slide.querySelector('[data-week-label]');
      if (label) label.textContent = index === current ? 'Diese Woche' : index > current ? 'Nächste Woche' : 'Letzte Woche';
    });

    if (slides.length > 1) {
      const prev = section.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next = section.querySelector<HTMLButtonElement>('[data-next]')!;
      const position = () => Math.round(track.scrollLeft / track.clientWidth);
      const goTo = (pos: number) => track.scrollTo({ left: pos * track.clientWidth });
      const updateArrows = () => {
        const pos = position();
        prev.hidden = pos <= 0;
        next.hidden = pos >= slides.length - 1;
      };

      // start on this week without an animation
      const behavior = track.style.scrollBehavior;
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = current * track.clientWidth;
      track.style.scrollBehavior = behavior;

      track.addEventListener('scroll', updateArrows, { passive: true });
      prev.addEventListener('click', () => goTo(position() - 1));
      next.addEventListener('click', () => goTo(position() + 1));
      updateArrows();
    }
  }
</script>

<style>
  .week {
    position: relative;
    margin-bottom: 32px;
    padding: 18px 16px 20px;
    background: var(--papier);
    border: 1px solid var(--karamell);
    border-radius: var(--radius);
  }

  /* The strip: one slide per week, swipeable, one week visible at a time. */
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }

  .slide {
    display: grid;
    flex: 0 0 100%;
    gap: 18px;
    min-width: 0;
    align-content: start;
    scroll-snap-align: start;
  }

  .arrow {
    position: absolute;
    top: 14px;
    z-index: 1;
    width: 36px;
    height: 36px;
    border: 1px solid var(--karamell);
    border-radius: 50%;
    background: var(--papier);
    color: var(--rost);
    font: 400 24px/1 var(--font-body);
    cursor: pointer;
    padding: 0 0 3px;
  }

  .arrow:hover,
  .arrow:focus-visible {
    background: var(--senf-hell);
  }

  .prev {
    right: 58px;
  }

  .next {
    right: 14px;
  }

  .week-head {
    display: grid;
    gap: 4px;
  }

  /* room for the two arrows beside the heading */
  .multi .week-head {
    padding-right: 88px;
  }

  h2 {
    font-size: 26px;
    color: var(--kuerbis);
  }

  .week-dates {
    font-size: 15px;
    color: var(--kastanie);
  }

  .week-note {
    margin-top: 4px;
  }

  .days {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .day {
    display: grid;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--karamell);
  }

  .weekday {
    font-size: 19px;
  }

  .slot {
    display: grid;
    gap: 4px;
  }

  .free,
  .plain {
    color: var(--kastanie);
  }

  .meal {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meal-link {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .meal-link:hover .meal-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .thumb {
    flex: none;
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--leinen);
  }

  .meal-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .meal-title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.2;
    color: var(--kuerbis);
  }

  .meal-meta {
    font-size: 14px;
    color: var(--kastanie);
  }

  .pick {
    flex: none;
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--rost);
    cursor: pointer;
  }

  .shopping {
    display: grid;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--karamell);
  }

  .pick-status {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 15px;
    color: var(--kastanie);
  }

  .bring {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: 15px;
  }

  .bring-link {
    display: inline-block;
    padding: 8px 18px;
    border: 1px solid var(--rost);
    border-radius: 999px;
    background: var(--papier);
    color: var(--rost);
    font-weight: 700;
    text-decoration: none;
  }

  .bring-link:hover {
    background: var(--rost);
    color: var(--papier);
  }

  .bring-link[aria-disabled='true'] {
    opacity: 0.45;
    pointer-events: none;
  }

  .list summary {
    cursor: pointer;
    font-weight: 500;
  }

  .ingredient-list {
    display: grid;
    gap: 6px;
    margin: 10px 0 0;
    padding: 12px 14px;
    list-style: none;
    background: var(--leinen);
    border-radius: 8px;
  }

  /* :global because the script rebuilds these rows, and new elements carry no scoped-style attribute */
  .ingredient-list :global(.ingredient) {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .ingredient-list :global(.amount) {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ingredient-list :global(.note) {
    color: var(--kastanie);
  }

  .empty {
    margin-top: 10px;
  }

  @media (min-width: 720px) {
    .week {
      padding: 22px 24px 24px;
    }

    .arrow {
      top: 18px;
    }

    .prev {
      right: 66px;
    }

    .next {
      right: 22px;
    }

    .day {
      grid-template-columns: 120px 1fr 1fr;
      gap: 16px;
      align-items: start;
    }

    .weekday {
      padding-top: 2px;
    }

    .free {
      grid-column: 2 / -1;
    }

    /* lunch always in the middle column, dinner always on the right */
    .slot.lunch {
      grid-column: 2;
    }

    .slot.dinner {
      grid-column: 3;
    }
  }
</style>
